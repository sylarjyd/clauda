{
  "name": "clauda",
  "version": "0.1.0",
  "description": "终端编码 Agent —— 参考 Claude Code 的功能实现，后端走 OpenAI 兼容接口",
  "type": "module",
  "bin": {
    "clauda": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node tests/unit.mjs && node tests/e2e.mjs",
    "test:unit": "node tests/unit.mjs",
    "test:e2e": "node tests/e2e.mjs",
    "mock": "node tests/mock-server.mjs",
    "desktop": "npm run build && electron desktop/main.js"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "commander": "^12.1.0",
    "dotenv": "^16.4.7",
    "openai": "^4.77.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "electron": "^44.7.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "license": "MIT"
}
