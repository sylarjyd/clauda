# 复制为 .env 后填写。环境变量优先级高于 ~/.clauda/config.json
#
# 三家常见后端任选其一，把注释打开即可：

# --- DeepSeek ---
# CLAUDA_BASE_URL=https://api.deepseek.com/v1
# CLAUDA_API_KEY=sk-xxxxxxxxxxxxxxxx
# CLAUDA_MODEL=deepseek-chat

# --- 月之暗面 Kimi ---
# CLAUDA_BASE_URL=https://api.moonshot.cn/v1
# CLAUDA_API_KEY=sk-xxxxxxxxxxxxxxxx
# CLAUDA_MODEL=kimi-k2-0905-preview

# --- 本地 Ollama ---
# CLAUDA_BASE_URL=http://localhost:11434/v1
# CLAUDA_API_KEY=ollama
# CLAUDA_MODEL=qwen2.5-coder:14b

# --- OpenAI 官方 ---
# CLAUDA_BASE_URL=https://api.openai.com/v1
# CLAUDA_API_KEY=sk-xxxxxxxxxxxxxxxx
# CLAUDA_MODEL=gpt-4o

# 兼容写法（不写 CLAUDA_ 前缀时也会被读取）
# OPENAI_BASE_URL=
# OPENAI_API_KEY=
